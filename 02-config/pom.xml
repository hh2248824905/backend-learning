<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承多模块父工程 -->
    <parent>
        <groupId>top.a1788</groupId>
        <artifactId>backend-learning</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>02-config</artifactId>
    <name>02-config</name>
    <description>Spring Boot 配置管理：application.yml + @Value 注入 + API Fox 集成演示</description>

    <dependencies>
        <!-- Spring Web：提供 @RestController、@Value 等（版本由父工程管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Lombok：@Data 自动生成 Getter/Setter（版本由父工程管理） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Validation：@Validated + @NotBlank/@Min/@Max 配置校验（版本由父工程管理） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- OpenAPI 注解：Apifox Helper 上传时读取 @Tag/@Operation，用于生成接口分组名和文档说明 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.34</version>
        </dependency>

        <!-- Spring Boot Test：@SpringBootTest + JUnit 5（仅测试期生效） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件：java -jar 直接运行 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 本模块有两个 @SpringBootApplication（com.itheima.Application 旧代码 /
                         top.a1788.config.ConfigApplication 配置案例），打包时必须指定唯一主类，
                         否则报 "Unable to find a single main class"。
                         IDEA 里两个类依然都能单独运行，这里只决定 jar 的启动类。 -->
                    <mainClass>top.a1788.config.ConfigApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
