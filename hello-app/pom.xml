<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.houduan</groupId>
        <artifactId>houduan-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>hello-app</artifactId>
    <name>hello-app</name>
    <description>演示用入口：调用 hello-core 的能力，打印结果</description>

    <dependencies>
        <!-- 依赖兄弟模块（版本由父工程统一管理） -->
        <dependency>
            <groupId>com.example.houduan</groupId>
            <artifactId>hello-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包成可执行的 jar：java -jar hello-app.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.example.houduan.app.AppMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- shade 插件：把 hello-core 也打进来，输出可独立运行的 fat jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
